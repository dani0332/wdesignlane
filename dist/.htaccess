# =============================================================
#  Web Design Lane — Apache config
#  Copied into dist/ by build.mjs. Upload to the web root.
#  Requires mod_rewrite, mod_deflate, mod_expires, mod_headers.
# =============================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---- 1. canonical host: force HTTPS + www --------------------
# Behind Cloudflare, use the forwarded proto or you get a loop.
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.webdesignlane.com%{REQUEST_URI} [R=301,L]

# ---- 2. /index and /index.html  ->  / ------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# ---- 3. /about.html  ->  /about ------------------------------
# THE_REQUEST matches only the original browser request, so the
# internal rewrite in rule 5 does not re-trigger this. Without
# that guard this pair loops.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---- 4. strip trailing slash (real directories excepted) -----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/$ /$1 [R=301,L]

# ---- 5. /about  ->  about.html (internal, URL unchanged) -----
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ---- 6. real 404s --------------------------------------------
# The current live site returns HTTP 200 for missing pages, so
# Google indexes junk URLs. This returns a true 404.
ErrorDocument 404 /404.html

# ---- 7. caching ----------------------------------------------
<IfModule mod_headers.c>
  # HTML: always revalidate, so new asset URLs are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed assets (base.a3f9c1.css) never change under a name.
  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images: long, but not immutable (filenames are not hashed).
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- 8. compression ------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain \
    text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---- 9. don't serve dotfiles or source ------------------------
<FilesMatch "^\.|\.(mjs|json|md)$">
  Require all denied
</FilesMatch>
